# Normalize to LF in the repo; Git converts on checkout for the platform.
* text=auto eol=lf

*.go    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Fixtures must be byte-stable: the classifier tests compare exact bytes.
*.http  -text
*.bin   binary
*.png   binary
*.ico   binary
*.jpg   binary
