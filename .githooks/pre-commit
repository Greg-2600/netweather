#!/bin/sh
# netweather pre-commit hook (QUALITY.md §8).
#
# Opt in once per clone:
#
#   git config core.hooksPath .githooks
#
# It runs the fast, deterministic part of the gate: formatting, vet, and the
# same test task CI runs. Anything slower (coverage floors, UI, compose,
# mutation, scanners) stays in CI so a commit does not take minutes.

set -eu

go run ./internal/devtool fmt -check
go vet ./...
go run ./internal/devtool test
