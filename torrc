# netweather Tor sidecar configuration (docs/IMAGE.md 7).
#
# Baked into the image on purpose: the lines that matter are the ones a
# forgotten mount would silently drop. The monitor only ever reads from this
# proxy, so it carries no exit traffic, no bridge, and no descriptor.
ClientOnly 1
ExitPolicy reject *:*
BridgeRelay 0
PublishServerDescriptor 0

# The app reaches this over the compose egress network; nothing is published.
# IsolateSOCKSAuth makes a SOCKS username/password a circuit-isolation key, so
# two clients that present different credentials do not share circuits. Tor
# accepts arbitrary credentials for isolation; it is not an access control
# (DESIGN.md 5.7).
SocksPort 0.0.0.0:9050 IsolateSOCKSAuth

# Read-only control channel used only to ask Tor's own GeoIP database where the
# observed exit address lives. It stays on the egress network and is never
# published; the password is a shared deployment constant, not an operator
# secret (the control commands available here cannot turn this client into a
# relay). Cymru still supplies the ASN, but a registrar's country is not a
# reliable exit location, so it is not used for the country label.
ControlPort 0.0.0.0:9051
HashedControlPassword 16:37CEADE74D08592C60D89583F659CD4A5D99123C41E80471A77ECA9D05

# The release image runs read-only with a tmpfs at /tmp, and tor needs a
# writable data directory it owns.
DataDirectory /tmp/tor

# Logs go to stdout so `docker logs` keeps them; SafeLogging strips addresses
# from those lines.
Log notice stdout
SafeLogging 1

# Keep an exit circuit for at least an hour: measurements taken minutes apart
# from the same circuit are comparable, and a different exit mid-incident would
# look like a path change (DESIGN.md 5.7).
MaxCircuitDirtiness 3600
