# syntax=docker/dockerfile:1
#
# The Tor sidecar's own image (docs/IMAGE.md 7). We build it rather than pull a
# third-party Tor image so the client-only torrc is baked in: an operator cannot
# forget a mount and turn the monitor's proxy into an exit node.
#
# Alpine, not Wolfi: Chainguard's Wolfi base does not package tor, so the
# sidecar would fail to build there. Alpine 3.20 packages it, is small, and is
# pinned by digest like the main image (THREAT_MODEL.md T61/T63); Dependabot
# updates the digest weekly.
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

USER 0

RUN apk add --no-cache tor ca-certificates-bundle \
 && mkdir -p /tmp/tor \
 && chown 65532:65532 /tmp/tor

COPY --chmod=0644 torrc /etc/tor/torrc

USER 65532:65532
EXPOSE 9050

ENTRYPOINT ["tor", "-f", "/etc/tor/torrc"]
